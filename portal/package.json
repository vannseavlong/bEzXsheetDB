{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "cp .env.testing .env && react-router dev --host",
    "window:dev": "shx .env.testing .env && react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "pm2:pro": "pm2 start serve --name 'bEasy-portal-pro' -- -s build/client -p 3002",
    "pm2:dev": "pm2 start serve --name 'bEasy-portal-dev' -- -s build/client -p 4000",
    "deploy:dev": "cp .env.dev .env && firebase use dev && npm run build && firebase deploy --only hosting:dev",
    "deploy:pro": "cp .env.pro .env && firebase use pro && npm run build && firebase deploy --only hosting:pro",
    "deploy-window:dev": "shx .env.dev .env && firebase use dev && npm run build && firebase deploy --only hosting:dev",
    "deploy:pro-window": "shx .env.pro .env && firebase use pro && npm run build && firebase deploy --only hosting:pro",
    "deploy:all": "npm run deploy:dev && npm run deploy:pro"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.1.1",
    "@lexical/react": "^0.38.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-google-maps/api": "^2.20.7",
    "@react-router/node": "^7.5.3",
    "@react-router/serve": "^7.5.3",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.24",
    "hugeicons-react": "^0.3.0",
    "i18next": "^25.3.2",
    "immer": "^10.1.1",
    "isbot": "^5.1.27",
    "js-cookie": "^3.0.5",
    "lexical": "^0.38.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.554.0",
    "moment": "^2.30.1",
    "next-themes": "^0.4.6",
    "numeral": "^2.0.6",
    "react": "^19.2.3",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.59.0",
    "react-i18next": "^15.6.1",
    "react-router": "^7.5.3",
    "recharts": "2.15.4",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@react-router/dev": "^7.5.3",
    "@tailwindcss/vite": "^4.1.4",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "6.1.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "shx": "^0.3.4",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^6.3.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
